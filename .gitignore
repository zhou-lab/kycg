# build products
*.o
*.a
/kycg

# test binaries (tests/*.c compile to extensionless binaries beside them).
# A pattern, not a list: the Makefile discovers tests with $(wildcard
# tests/*.c), so any new test produced a binary that `git add -A` would
# happily commit. The negation keeps the sources tracked.
/tests/test_*
!/tests/test_*.c

